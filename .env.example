# Azure Cognitive Services – Speech (required only for voiceover scenes)
# Get credentials at https://portal.azure.com > Cognitive Services > Speech
SPEECH_KEY=your_azure_speech_key_here
SPEECH_REGION=canadacentral

# Compatibility names consumed by manim-voiceover 0.3.x.
AZURE_SUBSCRIPTION_KEY=${SPEECH_KEY}
AZURE_SERVICE_REGION=${SPEECH_REGION}
